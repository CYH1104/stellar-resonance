{
  "name": "stellar-resonance-frontend",
  "version": "0.20.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/sync-terminal.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
  "start:stable": "node scripts/launch-stable.mjs",
  "start:test": "node scripts/launch-test.mjs",
  "stop": "node scripts/stop-local.mjs",
    "native:install": "npm --prefix native/SillyTavern ci --omit=dev --no-audit --no-fund",
    "native:start": "npm --prefix native/SillyTavern start --",
    "native:skin:build": "vite build --config vite.native.config.ts",
    "native:skin:install": "npm run native:skin:build && node scripts/install-native-skin.mjs",
    "native:frontend:build": "vite build --config vite.academy.config.ts && node scripts/build-academy-frontend.mjs",
    "native:compat:install": "node scripts/install-academy-compat.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "users": "node scripts/users.mjs",
    "editor:key": "node scripts/editor-key.mjs",
    "invites": "node scripts/invites.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
